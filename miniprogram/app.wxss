/**
 * Tokens mirrored from the public web app's classic theme.
 */
page {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --primary-soft: #eff6ff;
  --primary-border: rgba(37, 99, 235, 0.2);
  --secondary: #f59e0b;
  --success: #10b981;
  --ink: #111827;
  --ink-hover: #000000;
  --bg-primary: #ffffff;
  --bg-secondary: #f6f7f9;
  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-tertiary: #9ca3af;
  --border-light: #e5e7eb;
  --border-medium: #d1d5db;
  --error: #ef4444;
  --warn: #b45309;
  --warn-soft: rgba(245, 158, 11, 0.1);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 36rpx;
  --shadow-sm: 0 2rpx 4rpx rgba(17, 24, 39, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  --shadow-lg: 0 16rpx 56rpx rgba(17, 24, 39, 0.08);
  --shadow-xl: 0 32rpx 80rpx rgba(17, 24, 39, 0.14);
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;

  background: var(--bg-secondary);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* Neutralize native button chrome; components style their own buttons. */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}
button::after { border: none; }
button[disabled] { color: inherit; background: transparent; }

.card {
  background: var(--bg-primary);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

/* Secondary text pill button (重置/继续 style actions). */
.ghost-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 18rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 600;
}
.ghost-btn.disabled { opacity: 0.5; }

.error-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  border-radius: var(--radius-md);
  background: rgba(239, 68, 68, 0.06);
  color: var(--error);
  font-size: 26rpx;
  font-weight: 500;
}
