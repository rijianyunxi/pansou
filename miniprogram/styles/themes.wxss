.themed-page { min-height: 100vh; box-sizing: border-box; background: #fffdf7; }
.themed-page.tab-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.themed-page .card { border: 1rpx solid #ece7de; background: #fff; border-radius: 24rpx; box-shadow: none; }
.themed-page .user-info, .themed-page .add-input { min-width: 0; }
.themed-page .user-name { overflow-wrap: anywhere; }
.themed-page .avatar { flex-shrink: 0; }
.themed-page .remove-btn { min-height: 88rpx; }
