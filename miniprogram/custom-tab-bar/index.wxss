.dock { position: fixed; z-index: 200; bottom: 0; left: 0; right: 0; padding: 12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom)); background: linear-gradient(transparent, #f6f7f9); }
.dock-surface { display: flex; gap: 12rpx; padding: 10rpx; border: 2rpx solid rgba(255,255,255,.95); border-radius: 36rpx; background: rgba(255,255,255,.94); box-shadow: 0 8rpx 40rpx rgba(30,50,80,.12); -webkit-backdrop-filter: blur(32rpx); backdrop-filter: blur(32rpx); }
.tab { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; gap: 20rpx; min-height: 96rpx; margin: 0; padding: 8rpx 20rpx; border: 2rpx solid transparent; border-radius: 26rpx; background: transparent; color: #596579; font-size: 28rpx; line-height: 1.5; }
.tab::after { border: 0; }
.selected { color: #2563eb; background: #eff6ff; font-weight: 700; }
.pressed { opacity: .7; }
.active-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.icon { position: relative; width: 44rpx; height: 44rpx; flex-shrink: 0; }
.icon-search::before { content: ''; position: absolute; left: 2rpx; top: 2rpx; width: 26rpx; height: 26rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.icon-search::after { content: ''; position: absolute; width: 19rpx; height: 4rpx; right: 0; bottom: 5rpx; transform: rotate(45deg); border-radius: 4rpx; background: currentColor; }
.icon-user::before { content: ''; position: absolute; left: 13rpx; top: 0; width: 14rpx; height: 14rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.icon-user::after { content: ''; position: absolute; left: 3rpx; bottom: 0; width: 34rpx; height: 17rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 24rpx 24rpx 0 0; }
.theme-geometric { background: linear-gradient(transparent, #fffbed); }
.theme-geometric .dock-surface { border: 4rpx solid #20201e; border-radius: 16rpx; background: #fffefa; box-shadow: 6rpx 6rpx 0 #20201e; backdrop-filter: none; }
.theme-geometric .tab { border-radius: 8rpx; color: #20201e; }
.theme-geometric .selected { border-color: #20201e; background: #ffe48a; box-shadow: 4rpx 4rpx 0 #20201e; }
.theme-geometric .active-dot { background: #3155e7; border-radius: 0; }

/* Floating glass capsule: opaque fallback, progressive blur on supported clients. */
.theme-classic.dock { padding-left: 48rpx; padding-right: 48rpx; background: transparent; }
.theme-classic .dock-surface {
  position: relative;
  overflow: hidden;
  gap: 16rpx;
  padding: 10rpx;
  border: 2rpx solid rgba(255,255,255,.88);
  border-radius: 999rpx;
  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(231,239,250,.92));
  box-shadow: 0 18rpx 52rpx rgba(32,52,82,.2), 0 3rpx 8rpx rgba(32,52,82,.08), inset 0 3rpx 3rpx #fff, inset 2rpx 0 5rpx rgba(255,255,255,.9), inset 0 -3rpx 6rpx rgba(113,148,194,.3);
  -webkit-backdrop-filter: blur(60rpx) saturate(190%);
  backdrop-filter: blur(60rpx) saturate(190%);
}
.theme-classic .dock-surface::before {
  content: ''; position: absolute; pointer-events: none; left: 12%; right: 12%; top: 0; height: 2rpx;
  background: linear-gradient(90deg, transparent, #fff, transparent);
}
.theme-classic .tab {
  z-index: 1; flex-direction: column; gap: 6rpx; min-height: 104rpx;
  padding: 10rpx 16rpx; border-radius: 999rpx; color: #526077;
  font-size: 22rpx; letter-spacing: 1rpx;
  transition: background-color .2s ease, box-shadow .2s ease, transform .2s ease;
}
.theme-classic .dock-surface::after {
  content: ''; position: absolute; pointer-events: none; inset: 0; border-radius: inherit;
  background: linear-gradient(115deg, rgba(255,255,255,.45), transparent 28%, transparent 72%, rgba(208,229,255,.25));
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.28);
}
.theme-classic .selected {
  color: #185ad6; border-color: rgba(255,255,255,.9);
  background: linear-gradient(145deg, rgba(255,255,255,.66), rgba(201,223,255,.28));
  box-shadow: inset 0 2rpx 2rpx #fff, inset 0 -2rpx 4rpx rgba(129,166,220,.18), 0 4rpx 12rpx rgba(49,93,151,.1);
}
.theme-classic .active-dot { display: none; }
.theme-classic .pressed { opacity: .85; transform: scale(.97); }
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .theme-classic .dock-surface { background: linear-gradient(145deg, rgba(255,255,255,.42), rgba(231,239,250,.20)); }
}
@media (prefers-reduced-motion: reduce) {
  .theme-classic .tab { transition: none; }
  .theme-classic .pressed { transform: none; }
}
