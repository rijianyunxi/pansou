.dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 150; padding-bottom: env(safe-area-inset-bottom); background: #fff; border-top: 1rpx solid #ece7de; }
.dock-surface { display: flex; }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; min-height: 112rpx; color: #827c73; font-size: 22rpx; background: transparent; border: 0; }
.tab::after { border: 0; }
.selected { color: #e85116; font-weight: 650; }
.icon { position: relative; width: 34rpx; height: 34rpx; box-sizing: border-box; }
.icon-search { border: 4rpx solid currentColor; border-radius: 50%; }
.icon-search::after { content: ''; position: absolute; width: 18rpx; height: 4rpx; right: -13rpx; bottom: -5rpx; background: currentColor; transform: rotate(45deg); border-radius: 4rpx; }
.icon-user::before { content: ''; position: absolute; width: 16rpx; height: 16rpx; left: 7rpx; top: -3rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-user::after { content: ''; position: absolute; width: 32rpx; height: 16rpx; left: 0; bottom: -6rpx; border: 3rpx solid currentColor; border-radius: 20rpx 20rpx 6rpx 6rpx; }
.active-dot { display: none; }
.pressed { opacity: .65; }
