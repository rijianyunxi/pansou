<view class="dock theme-{{theme}}">
  <view class="dock-surface">
    <button wx:for="{{tabs}}" wx:key="path" class="tab {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="switchTab" hover-class="pressed" aria-label="{{item.label}}{{selected === index ? '，当前页面' : ''}}">
      <view class="icon icon-{{item.icon}}"><view class="icon-detail"></view></view>
      <text>{{item.label}}</text>
      <view class="active-dot" wx:if="{{selected === index}}"></view>
    </button>
  </view>
</view>
