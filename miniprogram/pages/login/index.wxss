.page {
  padding: 96rpx 48rpx 64rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 56rpx;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border-radius: 40rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
  font-weight: 800;
}

.title {
  color: var(--text-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.hint {
  margin: 28rpx 0;
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}

.hint.success {
  color: #15803d;
  font-weight: 600;
  text-align: center;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-btn[disabled] {
  background: var(--primary);
  color: #ffffff;
  opacity: 0.6;
}

.plain-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  min-height: 92rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 600;
}

.state-card {
  padding: 36rpx 32rpx;
  text-align: center;
}

.state-title {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.state-value {
  margin-top: 12rpx;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.error {
  margin-top: 28rpx;
  color: #b42318;
  font-size: 28rpx;
}
