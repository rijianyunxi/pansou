<view class="login-page themed-page theme-{{theme}}">
  <view class="login-card">
    <view class="brand"><view class="brand-mark" aria-hidden="true"></view><text>盘搜</text></view>
    <view class="login-title">{{scene ? (confirmed ? '登录成功' : '确认网页登录') : (user ? '已登录' : '登录盘搜')}}</view>
    <block wx:if="{{scene}}">
      <text wx:if="{{confirmed}}" class="status-text">请返回网页继续</text>
      <button wx:else size="mini" class="login-button" bindtap="onConfirmQr" disabled="{{busy}}" loading="{{busy}}">确认登录</button>
    </block>
    <block wx:elif="{{user}}">
      <text class="status-text">{{user.nickname || user.username}}</text>
      <button size="mini" class="login-button secondary" bindtap="onLogout" disabled="{{busy}}">退出登录</button>
    </block>
    <button wx:else size="mini" class="login-button" bindtap="onLogin" disabled="{{busy}}" loading="{{busy}}">微信登录</button>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  </view>
  <app-feedback theme="{{theme}}" toast="{{feedbackToast}}" modal="{{feedbackModal}}" bindconfirm="onFeedbackConfirm" bindcancel="onFeedbackCancel" />
</view>
