.profile { padding: 40rpx 28rpx; background: #fffdf7; }
.account-card { position: relative; overflow: hidden; padding: 32rpx; border: 1rpx solid #f2d3bb; border-radius: 28rpx; background: #fff1df; box-shadow: 4rpx 5rpx 0 #f6d6bd; }
.account-orbit { position: absolute; width: 290rpx; height: 290rpx; top: 30rpx; right: -120rpx; border: 36rpx solid #ffdfbb; border-radius: 50%; pointer-events: none; }
.account-heading { position: relative; display: flex; align-items: center; justify-content: space-between; color: #a16c43; font-size: 24rpx; line-height: 36rpx; }
.account-badge { padding: 2rpx 16rpx; border: 1rpx solid #edc9a9; border-radius: 999rpx; color: #93613d; font-size: 20rpx; background: #fff8ee; }
.user-row { position: relative; display: flex; align-items: center; gap: 24rpx; margin: 30rpx 0; }
.profile .avatar { flex: 0 0 104rpx; width: 104rpx; height: 104rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 2rpx solid #fff; border-radius: 28rpx; background: #fffaf2; color: #e85116; font-size: 40rpx; font-weight: 600; transform: rotate(-5deg); }
.avatar text { transform: rotate(5deg); }
.person-icon { position: relative; width: 42rpx; height: 48rpx; transform: rotate(5deg); }
.person-icon::before { content: ''; position: absolute; left: 12rpx; top: 0; width: 18rpx; height: 18rpx; border: 3rpx solid #e85116; border-radius: 50%; box-sizing: border-box; }
.person-icon::after { content: ''; position: absolute; bottom: 0; left: 0; width: 42rpx; height: 24rpx; border: 3rpx solid #e85116; border-radius: 24rpx 24rpx 8rpx 8rpx; box-sizing: border-box; }
.user-info { flex: 1; min-width: 0; }
.user-name { font-size: 36rpx; line-height: 1.4; font-weight: 700; color: #24231f; overflow-wrap: anywhere; }
.user-sub { margin-top: 8rpx; font-size: 24rpx; color: #8e725b; overflow-wrap: anywhere; }
.profile button { font-family: inherit; box-sizing: border-box; margin: 0; }
.profile button::after { border: 0; }
.profile button.login-action { position: relative; display: flex; align-items: center; justify-content: center; gap: 16rpx; width: 100%; height: 84rpx; padding: 0 24rpx; border-radius: 16rpx; background: #f65b1b; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1; }
.login-arrow { font-size: 30rpx; font-weight: 400; }
.profile button[disabled] { opacity: .55; }
.profile button.channel-entry { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 152rpx; margin-top: 32rpx; padding: 28rpx; border: 1rpx solid #ece0d2; border-radius: 24rpx; background: #fff; color: #24231f; line-height: 1.4; text-align: left; }
.channel-symbol { display: flex; flex: 0 0 76rpx; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; gap: 5rpx; border-radius: 20rpx; background: #fff0e6; }
.channel-symbol view { width: 7rpx; height: 24rpx; border-radius: 4rpx; background: #ed652d; }
.channel-symbol view:nth-child(2) { height: 40rpx; }
.entry-title { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; }
.entry-arrow { flex: 0 0 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff6ed; color: #d84912; font-size: 30rpx; font-weight: 400; }
.menu { margin-top: 24rpx; border: 1rpx solid #ece7de; border-radius: 24rpx; overflow: hidden; background: #fff; }
.profile button.menu-item { width: 100%; min-height: 108rpx; padding: 24rpx 28rpx; display: flex; align-items: center; gap: 20rpx; border-radius: 0; background: #fff; line-height: 1.4; text-align: left; }
.menu-item + .menu-item { border-top: 1rpx solid #f0ebe4; }
.menu-text { flex: 1; min-width: 0; font-size: 26rpx; font-weight: 400; color: #625d55; }
.menu-arrow { font-size: 32rpx; font-weight: 400; color: #a69d90; }
.document-symbol { position: relative; width: 28rpx; height: 34rpx; margin: 0 4rpx; border: 2rpx solid #a39786; border-radius: 5rpx; box-sizing: border-box; }
.document-symbol::after { content: ''; position: absolute; left: 5rpx; right: 5rpx; top: 10rpx; height: 7rpx; border-top: 2rpx solid #a39786; border-bottom: 2rpx solid #a39786; }
.logout-symbol { width: 36rpx; color: #a39786; font-size: 32rpx; font-weight: 400; text-align: center; }
.action-pressed { opacity: .75; }
.profile button.menu-hover { background: #faf6ef; }
