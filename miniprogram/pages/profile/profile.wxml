<view class="profile">
  <view class="user-card card">
    <view class="avatar">{{user.nickname ? user.nickname[0] : (authenticated ? '·' : '客')}}</view>
    <view class="user-info">
      <view class="user-name">{{authenticated ? (user.nickname || user.username) : '未登录'}}</view>
      <view class="user-sub">{{authenticated ? user.username : '登录后可管理自定义频道'}}</view>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" hover-class="menu-hover" bindtap="onGoChannels">
      <text class="menu-text">自定义频道管理</text>
      <text class="menu-arrow">›</text>
    </view>

    <!-- <view class="menu-item" hover-class="menu-hover" bindtap="onAbout">
      <text class="menu-text">关于盘搜</text>
      <text class="menu-arrow">›</text>
    </view> -->
    <view class="menu-item" hover-class="menu-hover" bindtap="onCopyright">
      <text class="menu-text">版权与免责声明</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{authenticated}}" class="menu-item" hover-class="menu-hover" bindtap="onLogout">
      <text class="menu-text danger">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:else class="menu-item" hover-class="menu-hover" bindtap="onLogin">
      <text class="menu-text">微信登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footnote">首次微信登录会自动创建账号，无需注册</view>
</view>
