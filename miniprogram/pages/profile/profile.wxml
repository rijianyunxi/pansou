<view class="profile themed-page theme-{{theme}} tab-page">
  <view class="account-card">
    <view class="account-orbit" aria-hidden="true"></view>
    <view class="account-heading"><text>我的账号</text><view class="account-badge">{{authenticated ? '已登录' : '访客'}}</view></view>
    <view class="user-row">
      <view class="avatar"><text wx:if="{{authenticated}}">{{user.nickname ? user.nickname[0] : '我'}}</text><view wx:else class="person-icon" aria-hidden="true"></view></view>
      <view class="user-info">
        <view class="user-name">{{authenticated ? (user.nickname || user.username) : '未登录'}}</view>
        <view wx:if="{{authenticated && user.nickname && user.username}}" class="user-sub">{{user.username}}</view>
      </view>
    </view>
    <button wx:if="{{!authenticated}}" size="mini" class="login-action" bindtap="onLogin" disabled="{{loading}}" hover-class="action-pressed">微信登录<text class="login-arrow" aria-hidden="true">↗</text></button>
  </view>

  <button size="mini" class="channel-entry" bindtap="onGoChannels" hover-class="action-pressed">
    <view class="channel-symbol" aria-hidden="true"><view></view><view></view><view></view></view>
    <text class="entry-title">自定义频道</text>
    <view class="entry-arrow" aria-hidden="true">↗</view>
  </button>

  <view class="menu">
    <button size="mini" class="menu-item" bindtap="onCopyright" hover-class="menu-hover">
      <view class="document-symbol" aria-hidden="true"></view><text class="menu-text">版权与免责声明</text><text class="menu-arrow" aria-hidden="true">›</text>
    </button>
    <button wx:if="{{authenticated}}" size="mini" class="menu-item" bindtap="onLogout" disabled="{{loading}}" hover-class="menu-hover">
      <view class="logout-symbol" aria-hidden="true">↗</view><text class="menu-text">退出登录</text><text class="menu-arrow" aria-hidden="true">›</text>
    </button>
  </view>
  <app-feedback theme="{{theme}}" toast="{{feedbackToast}}" modal="{{feedbackModal}}" bindconfirm="onFeedbackConfirm" bindcancel="onFeedbackCancel" />
</view>
