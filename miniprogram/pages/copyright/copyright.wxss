.copyright-page {
  min-height: 100vh;
  padding: 36rpx 24rpx 64rpx;
  box-sizing: border-box;
}

.copyright-header { padding: 8rpx 8rpx 28rpx; }

.eyebrow {
  display: block;
  margin-bottom: 14rpx;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.page-title {
  display: block;
  color: var(--text-primary);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.lead {
  display: block;
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.75;
}

.copyright-card {
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  background: var(--bg-primary);
  box-shadow: var(--shadow-sm);
}

.section + .section { margin-top: 34rpx; }

.section-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.section-text,
.bullet-item {
  display: block;
  color: var(--text-secondary);
  font-size: 27rpx;
  line-height: 1.8;
}

.section-text + .section-text { margin-top: 14rpx; }

.email {
  display: block;
  margin: 8rpx 0 18rpx;
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1.6;
}

.bullet-list { margin: 8rpx 0 18rpx; }
.bullet-item + .bullet-item { margin-top: 4rpx; }

.copyright-note {
  display: block;
  margin: 24rpx 12rpx 0;
  color: var(--text-tertiary);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.theme-geometric .copyright-card {
  border: 2rpx solid #20201e;
  border-radius: 12rpx;
  box-shadow: 6rpx 6rpx 0 #20201e;
}
