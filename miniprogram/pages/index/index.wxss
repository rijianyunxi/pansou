.home { padding: 0 28rpx 40rpx; background: #fffdf7; }
.custom-nav { position: sticky; top: 0; z-index: 100; margin: 0 -28rpx; box-sizing: border-box; background: #fffdf7; }
.custom-nav-inner { width: 100%; display: flex; align-items: center; padding-left: 32rpx; box-sizing: border-box; }
.brand-lockup { display: flex; align-items: center; gap: 18rpx; }
.brand-mark { position: relative; width: 44rpx; height: 44rpx; border: 8rpx solid #ff5b18; border-radius: 50%; box-sizing: border-box; margin-right: 6rpx; }
.brand-mark::after { content: ''; position: absolute; width: 24rpx; height: 8rpx; background: #ff5b18; right: -20rpx; bottom: -8rpx; transform: rotate(45deg); border-radius: 4rpx; }
.brand-title { font-size: 36rpx; font-weight: 800; }
.hero { position: relative; padding: 40rpx 8rpx 36rpx; min-height: 280rpx; }
.hero-copy { position: relative; z-index: 1; }
.hero-eyebrow { display: block; font-size: 24rpx; color: #d84912; font-weight: 650; margin-bottom: 22rpx; }
.hero-title { display: block; font-size: 62rpx; line-height: 1.18; font-weight: 850; letter-spacing: -2rpx; }
.hero-accent { display: block; color: #f65b1b; }
.hero-subtitle { display: block; margin-top: 22rpx; font-size: 24rpx; color: #706c65; }
.hero-art { position: absolute; width: 320rpx; height: 240rpx; right: -10rpx; top: 30rpx; }
.search-workspace { padding: 24rpx; border: 1rpx solid #f5d9c5; border-radius: 24rpx; background: #fff; box-shadow: 3rpx 4rpx 0 #ffbb91; margin: 20rpx 0 34rpx; }
.search-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.scope-control { display: flex; gap: 28rpx; }
.scope-btn { display: flex; align-items: center; gap: 8rpx; min-height: 88rpx; border-bottom: 5rpx solid transparent; font-size: 26rpx; color: #706c65; }
.scope-btn.active { color: #24231f; font-weight: 700; border-color: #f65b1b; }
.scope-badge { font-size: 20rpx; border-radius: 10rpx; background: #f5f2ed; padding: 0 8rpx; }
.manage-channels { font-size: 24rpx; color: #d84912; min-height: 88rpx; display: flex; align-items: center; }
.search-card { display: grid; grid-template-columns: minmax(0, 1fr) 120rpx; align-items: center; gap: 14rpx; margin-top: 22rpx; }
.search-input-row { display: flex; align-items: center; flex: 1; min-width: 0; border: 1rpx solid #e5ded3; border-radius: 16rpx; padding-left: 18rpx; min-height: 88rpx; }
.search-input { flex: 1; min-width: 0; height: 88rpx; font-size: 28rpx; }
.search-placeholder { color: #827c73; font-size: 24rpx; }
.home .clear-btn { flex: 0 0 64rpx; width: 64rpx; margin: 0; padding: 0; background: transparent; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }
.clear-symbol::before { content: '×'; font-size: 34rpx; color: #827c73; }
.search-actions { display: flex; margin-left: auto; justify-content: flex-end; }
.action-left { order: 3; display: flex; align-items: center; gap: 12rpx; }
.action-left:empty { display: none; }
.search-btn { min-height: 88rpx; min-width: 110rpx; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; background: #f65b1b; color: #fff; border-radius: 16rpx; font-size: 28rpx; font-weight: 650; }
.search-btn-arrow { display: none; }
.home .reset-button, .home .search-control { width: auto; flex: none; margin: 0; background: transparent; display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 88rpx; padding: 0 18rpx; color: #706c65; font-size: 24rpx; }
.reset-symbol { width: 26rpx; height: 26rpx; }
.continue-control { color: #28815d; }
.pause-control { color: #ad6813; }
.disabled { opacity: .45; }
.hot-section { margin-top: 32rpx; }
.hot-title { font-size: 32rpx; font-weight: 750; margin-bottom: 22rpx; }
.hot-star { color: #f65b1b; font-size: 38rpx; }
.hot-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx 16rpx; }
.hot-item { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 0 18rpx; box-sizing: border-box; background: #faf3e8; border-radius: 16rpx; }
.hot-rank { color: #827c73; font-size: 24rpx; }
.hot-item.top .hot-rank { color: #d84912; }
.hot-term { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 26rpx; }
.search-history { margin: 28rpx 0; }
.history-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; min-height: 64rpx; font-size: 28rpx; font-weight: 600; line-height: 40rpx; }
.search-history button.history-clear { flex: none; width: auto; min-width: 0; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0; display: flex; align-items: center; background: transparent; border: 0; border-radius: 0; font-family: inherit; font-size: 24rpx; line-height: 32rpx; color: #827c73; font-weight: 400; }
.history-list { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12rpx; }
.history-chip { display: inline-flex; flex: 0 1 auto; align-items: center; width: auto; min-width: 0; max-width: 100%; box-sizing: border-box; border-radius: 12rpx; background: #f6f1e9; overflow: hidden; }
.search-history button.history-term { display: block; flex: 0 1 auto; width: auto; min-width: 0; max-width: calc(100% - 56rpx); height: 64rpx; box-sizing: border-box; margin: 0; padding: 16rpx 0 16rpx 18rpx; background: transparent; border: 0; border-radius: 0; color: #5f5b54; font-family: inherit; font-size: 24rpx; font-weight: 400; line-height: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: left; }
.search-history button.history-remove { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; width: 56rpx; min-width: 56rpx; max-width: 56rpx; height: 64rpx; min-height: 64rpx; box-sizing: border-box; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 0; font-family: inherit; font-size: 26rpx; font-weight: 400; line-height: 1; color: #938b7f; }
.search-history button::after { border: 0; }
.stats-bar.card { padding: 0; border: 0; background: transparent; margin: 30rpx 0; }
.stats-main { display: flex; gap: 22rpx; flex-wrap: wrap; align-items: center; font-size: 24rpx; }
.stat-item { display: flex; gap: 8rpx; align-items: baseline; }
.stat-label { color: #706c65; }
.stat-value { font-weight: 650; }
.paused-pill { color: #ad6813; }
.pills-scroll { margin-top: 24rpx; white-space: nowrap; }
.pills-track { display: inline-flex; gap: 12rpx; }
.filter-pill { display: inline-flex; align-items: center; gap: 8rpx; height: 64rpx; min-height: 64rpx; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #ece7de; border-radius: 44rpx; background: #fff; font-size: 24rpx; }
.filter-pill.active { background: #f65b1b; color: #fff; border-color: #f65b1b; }
.pill-count { opacity: .8; }
.sort-toolbar { margin-top: 22rpx; }
.sort-options { display: flex; gap: 12rpx; }
.home button.sort-option { flex: 1; display: flex; align-items: center; justify-content: center; height: 64rpx; min-height: 64rpx; font-family: inherit; font-weight: 400; border: 1rpx solid #ece7de; border-radius: 14rpx; background: #fff; color: #706c65; font-size: 24rpx; width: 0; min-width: 0; margin: 0; padding: 0 8rpx; box-sizing: border-box; line-height: 1.4; }
.home button.sort-option.is-selected { color: #c74510; background: #fff0e6; border-color: #f5be9b; font-weight: 600; }
.sort-option[disabled] { opacity: .5; }
.sort-hint { display: block; margin-bottom: 12rpx; font-size: 22rpx; color: #827c73; }
.resource-list.card { border: 0; background: transparent; }
.resource-list-item { border: 1rpx solid #ece7de; border-radius: 22rpx; overflow: hidden; margin-bottom: 18rpx; }
.load-more { padding: 28rpx; text-align: center; color: #d84912; }
.empty-card { padding: 50rpx 30rpx; text-align: center; }
.empty-title { font-size: 30rpx; font-weight: 650; }
.empty-desc { color: #706c65; margin-top: 16rpx; font-size: 24rpx; }
.empty-icon { color: #f65b1b; font-size: 64rpx; }
.home .back-top { position: fixed; right: 28rpx; bottom: calc(146rpx + env(safe-area-inset-bottom)); z-index: 90; flex: none; margin: 0; padding: 0; box-sizing: border-box; width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; min-height: 88rpx; max-height: 88rpx; line-height: 1; display: flex; align-items: center; justify-content: center; border: 1rpx solid #e6ddd1; border-radius: 50%; background: #fff; color: #d84912; box-shadow: 0 6rpx 20rpx #51361312; font-size: 42rpx; }
.btn-hover, .sort-pressed, .control-pressed, .reset-pressed, .clear-pressed { opacity: .7; }

.home button.search-btn { display: flex; align-items: center; justify-content: center; width: 120rpx; min-width: 0; height: 88rpx; margin: 0; padding: 0; box-sizing: border-box; font-size: 28rpx; font-weight: 600; line-height: 1; }
.home button.search-btn-pause { background: #fff0e6; border: 1rpx solid #f5be9b; color: #c74510; }
