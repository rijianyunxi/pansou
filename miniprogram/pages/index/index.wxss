.home {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
}

/* 经典主题顶部栏：右侧按胶囊左边界动态预留空间。 */
.custom-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  margin: 0 -24rpx;
  box-sizing: border-box;
  background: var(--bg-primary);
  border-bottom: 1rpx solid var(--border-light);
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-left: 48rpx;
  box-sizing: border-box;
}

.brand-lockup { display: flex; align-items: center; gap: 24rpx; min-width: 0; }

.brand-mark {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--ink);
}

.brand-mark::before {
  content: "";
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.brand-mark::after {
  content: "";
  position: absolute;
  right: 13rpx;
  bottom: 14rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: rotate(45deg);
}

.brand-title { overflow: hidden; color: var(--text-primary); font-size: 34rpx; font-weight: 700; letter-spacing: -1rpx; white-space: nowrap; }

.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin-left: 12rpx;
  box-sizing: border-box;
}

.theme-toggle-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 16rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  box-sizing: border-box;
}

.theme-toggle-hover .theme-toggle-surface { background: var(--bg-secondary); }

.theme-icon { position: relative; width: 30rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 8rpx; box-sizing: border-box; }
.theme-icon.classic::before,
.theme-icon.classic::after { content: ""; position: absolute; background: currentColor; }
.theme-icon.classic::before { top: 9rpx; left: -3rpx; width: 30rpx; height: 3rpx; }
.theme-icon.classic::after { top: 9rpx; left: 9rpx; width: 3rpx; height: 18rpx; }
.theme-icon.geometric { border: 0; border-radius: 0; background: #3155e7; transform: rotate(30deg); }
.theme-icon.geometric::before,
.theme-icon.geometric::after { content: ""; position: absolute; background: #f59e0b; }
.theme-icon.geometric::before { top: -5rpx; right: -5rpx; width: 13rpx; height: 13rpx; border-radius: 50%; }
.theme-icon.geometric::after { bottom: -6rpx; left: -5rpx; width: 14rpx; height: 14rpx; }

.hero { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 56rpx 16rpx 8rpx; text-align: center; }
.hero-title { margin: 0; color: var(--text-primary); font-size: 56rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.2; }
.hero-subtitle { color: var(--text-tertiary); font-size: 28rpx; line-height: 1.65; }

.search-workspace {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 32rpx;
  padding: 40rpx;
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  background: var(--bg-primary);
  box-shadow: var(--shadow-sm);
}

.search-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.scope-control { display: inline-flex; gap: 8rpx; padding: 8rpx; border: 1rpx solid var(--border-light); border-radius: 26rpx; background: var(--bg-secondary); }
.scope-btn { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 72rpx; padding: 0 28rpx; border: 1rpx solid transparent; border-radius: 18rpx; color: var(--text-secondary); font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.scope-btn.active { border-color: var(--border-light); background: var(--bg-primary); box-shadow: var(--shadow-sm); color: var(--primary); }
.scope-badge { display: flex; align-items: center; justify-content: center; min-width: 36rpx; height: 36rpx; padding: 0 10rpx; border-radius: 10rpx; background: var(--primary-soft); color: var(--primary); font-size: 20rpx; font-weight: 700; }
.manage-channels { display: inline-flex; align-items: center; min-height: 72rpx; padding: 0 18rpx; border-radius: 16rpx; color: var(--primary); font-size: 25rpx; font-weight: 600; white-space: nowrap; }
.manage-plus { margin-right: 6rpx; font-size: 32rpx; font-weight: 400; }

.search-card { padding: 28rpx 28rpx 20rpx; border-radius: 28rpx; background: var(--bg-secondary); box-sizing: border-box; }
.search-input-row { display: flex; align-items: center; gap: 16rpx; }
.search-input { flex: 1; min-width: 0; min-height: 72rpx; color: var(--text-primary); font-size: 30rpx; }
.search-placeholder { color: var(--text-tertiary); }
.clear-btn { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 50%; color: var(--text-tertiary); font-size: 22rpx; }
.search-actions { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; }
.action-left { display: flex; align-items: center; gap: 12rpx; min-height: 72rpx; }
.ghost-btn { min-height: 72rpx; padding: 0 28rpx; border-radius: 999rpx; }
.ghost-btn.pause { border-color: rgba(245, 158, 11, 0.3); background: rgba(245, 158, 11, 0.1); color: #b45309; }
.ghost-btn.continue { border-color: rgba(16, 185, 129, 0.3); background: rgba(16, 185, 129, 0.1); color: #047857; }
.search-btn { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-width: 168rpx; min-height: 76rpx; padding: 0 36rpx; border-radius: 999rpx; background: var(--ink); color: #ffffff; font-size: 28rpx; font-weight: 700; }
.search-btn-arrow { font-size: 32rpx; line-height: 1; }
.search-btn.disabled { opacity: 0.55; }
.spinner { width: 32rpx; height: 32rpx; border: 4rpx solid var(--border-light); border-top-color: var(--text-primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.hot-section { margin-top: 36rpx; }
.hot-title { margin-bottom: 18rpx; color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.hot-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.hot-item { display: flex; align-items: center; gap: 14rpx; padding: 24rpx 22rpx; border: 1rpx solid var(--border-light); border-radius: var(--radius-lg); background: var(--bg-primary); }
.hot-item.top { background: var(--primary-soft); border-color: #bfdbfe; }
.hot-rank { color: var(--primary); font-size: 22rpx; font-weight: 800; }
.hot-term { flex: 1; min-width: 0; overflow: hidden; color: var(--text-primary); font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }

.stats-bar { margin-top: 28rpx; padding: 20rpx; }
.stats-main { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; }
.stat-item { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 20rpx; border-radius: var(--radius-md); background: var(--bg-secondary); }
.stat-label { color: var(--text-tertiary); font-size: 24rpx; }
.stat-value { color: var(--text-primary); font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.paused-pill { padding: 10rpx 20rpx; border-radius: 999rpx; background: var(--warn-soft); color: var(--warn); font-size: 24rpx; font-weight: 500; }
.pills-scroll { margin-top: 16rpx; width: 100%; }
.pills-track { display: inline-flex; flex-wrap: nowrap; gap: 12rpx; padding: 4rpx 0; }
.filter-pill { display: inline-flex; align-items: center; gap: 10rpx; flex: 0 0 auto; min-height: 60rpx; padding: 0 20rpx; border: 1rpx solid var(--border-light); border-radius: 14rpx; background: var(--bg-primary); color: var(--text-secondary); font-size: 24rpx; font-weight: 500; }
.filter-pill.active { border-color: transparent; background: var(--primary-soft); color: var(--primary); font-weight: 600; }
.pill-count { display: inline-flex; align-items: center; justify-content: center; min-width: 36rpx; height: 36rpx; padding: 0 10rpx; border-radius: 999rpx; background: var(--bg-secondary); color: var(--text-tertiary); font-size: 20rpx; font-weight: 700; }
.filter-pill.active .pill-count { background: rgba(37, 99, 235, 0.14); color: var(--primary); }
.sort-picker { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 16rpx; min-height: 72rpx; padding: 0 20rpx; border: 1rpx solid var(--border-light); border-radius: 18rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 600; }
.sort-picker-icon { color: var(--primary); font-size: 30rpx; }
.error-banner { margin-top: 24rpx; }
.error-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 34rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: #fee2e2; color: var(--error); font-size: 24rpx; font-weight: 800; }
.resource-list { margin-top: 24rpx; overflow: hidden; }
.resource-list-item + .resource-list-item { border-top: 1rpx solid var(--border-light); }
.load-more { margin-top: 24rpx; padding: 24rpx; color: var(--primary); font-size: 26rpx; font-weight: 600; text-align: center; }
.empty-card { margin-top: 48rpx; padding: 64rpx 48rpx; text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto; border-radius: 32rpx; background: var(--primary-soft); color: var(--primary); font-size: 72rpx; line-height: 1; }
.empty-title { margin-top: 20rpx; color: var(--text-primary); font-size: 32rpx; font-weight: 700; }
.empty-desc { margin-top: 12rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.6; }
.back-top { position: fixed; right: 28rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border: 1rpx solid var(--border-light); border-radius: 24rpx; background: rgba(255, 255, 255, 0.92); box-shadow: var(--shadow-lg); color: var(--primary); font-size: 36rpx; font-weight: 700; }

/* 与 Web 端 theme-geometric 保持一致：明快黄蓝、几何硬边、偏移阴影。 */
.theme-geometric { background: #fffbed; }
.theme-geometric .custom-nav { background: #fffbed; border-bottom: 2rpx solid #20201e; }
.theme-geometric .brand-mark { background: #ffe48a; border: 4rpx solid #20201e; }
.theme-geometric .brand-mark::before { border-color: #20201e; }
.theme-geometric .brand-mark::after { background: #20201e; }
.theme-geometric .theme-toggle-surface { border: 2rpx solid #20201e; border-radius: 10rpx; background: #ffe48a; color: #20201e; box-shadow: 3rpx 3rpx 0 #20201e; }
.theme-geometric .theme-toggle-hover .theme-toggle-surface { background: #ffda62; }
.theme-geometric .hero { position: relative; align-items: flex-start; padding: 50rpx 150rpx 24rpx 16rpx; text-align: left; }
.theme-geometric .hero::after { content: ""; position: absolute; right: 24rpx; top: 24rpx; width: 112rpx; height: 112rpx; border: 4rpx solid #20201e; border-radius: 50%; background: #ffe48a; box-shadow: 22rpx 26rpx 0 -6rpx #ffb687, 22rpx 26rpx 0 -3rpx #20201e; }
.theme-geometric .hero-title { position: relative; z-index: 1; max-width: 100%; font-size: 64rpx; line-height: 1.15; letter-spacing: -4rpx; }
.theme-geometric .hero-title::after { content: ""; display: block; width: 220rpx; height: 12rpx; margin-top: -10rpx; background: #ffe48a; transform: rotate(-2deg); }
.theme-geometric .hero-subtitle { color: #56564f; font-weight: 500; }
.theme-geometric .search-workspace { gap: 24rpx; padding: 28rpx 30rpx 32rpx; border: 4rpx solid #20201e; border-radius: 20rpx; background: #3155e7; box-shadow: 10rpx 10rpx 0 #20201e; }
.theme-geometric .scope-control { padding: 6rpx; border: 0; background: transparent; }
.theme-geometric .scope-btn { border-radius: 10rpx; color: #fffefa; }
.theme-geometric .scope-btn.active { border-color: #20201e; background: #ffe48a; box-shadow: 4rpx 4rpx 0 #20201e; color: #20201e; }
.theme-geometric .scope-badge { background: #fffefa; color: #20201e; }
.theme-geometric .manage-channels { color: #fffefa; }
.theme-geometric .search-card { padding: 26rpx 28rpx 22rpx; border: 4rpx solid #20201e; border-radius: 10rpx; background: #fffefa; }
.theme-geometric .search-btn { border: 2rpx solid #20201e; border-radius: 8rpx; background: #ffe48a; box-shadow: 4rpx 4rpx 0 #20201e; color: #20201e; }
.theme-geometric .search-btn:hover { background: #ffb687; }
.theme-geometric .ghost-btn { border-color: #20201e; border-radius: 8rpx; background: #fffbed; color: #20201e; }
.theme-geometric .hot-item { border: 2rpx solid #20201e; border-radius: 10rpx; box-shadow: 4rpx 4rpx 0 #20201e; }
.theme-geometric .hot-item:nth-child(3n + 1) { background: #ffe48a; }
.theme-geometric .hot-item:nth-child(3n + 2) { background: #e1e4fc; }
.theme-geometric .hot-item:nth-child(3n) { background: #ffcbab; }
.theme-geometric .hot-item.top { background: #3155e7; color: #fffefa; }
.theme-geometric .hot-item.top .hot-rank,
.theme-geometric .hot-item.top .hot-term { color: #fffefa; }
.theme-geometric .stats-bar,
.theme-geometric .resource-list,
.theme-geometric .empty-card { border: 2rpx solid #20201e; border-radius: 12rpx; box-shadow: 6rpx 6rpx 0 #20201e; }
.theme-geometric .filter-pill.active { border-color: #20201e; background: #ffe48a; color: #20201e; }

.btn-hover { opacity: 0.82; }

@media (max-width: 360px) {
  .custom-nav-inner { padding-left: 32rpx; }
  .brand-title { font-size: 30rpx; }
  .search-workspace { padding: 28rpx 24rpx; }
  .scope-btn { padding: 0 18rpx; font-size: 24rpx; }
  .theme-geometric .hero { padding-right: 124rpx; }
  .theme-geometric .hero-title { font-size: 56rpx; }
}
