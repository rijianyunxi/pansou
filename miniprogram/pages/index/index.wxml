<view class="home themed-page tab-page theme-{{theme}}">
  <view class="custom-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-inner" style="height: {{navContentHeight}}px; padding-right: {{capsuleReserve}}px;">
      <view class="brand-lockup">
        <view class="brand-mark"></view>
        <view class="brand-copy">
          <text class="brand-title">盘搜</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!searched}}" class="hero">
    <view class="hero-copy"><text class="hero-eyebrow">你的资源发现入口</text><text class="hero-title">想找的，<text class="hero-accent">都在这里。</text></text><text class="hero-subtitle">网盘、磁力、公开频道，一键搜索。</text></view>
    <image class="hero-art" src="/assets/discovery-hero.svg" mode="aspectFit" aria-hidden="true" />
  </view>

  <view class="search-workspace">
    <view class="search-toolbar">
      <view class="scope-control">
        <view class="scope-btn {{scope === 'site' ? 'active' : ''}}" hover-class="none" bindtap="onScopeSite">本站搜索</view>
        <view class="scope-btn {{scope === 'channels' ? 'active' : ''}}" bindtap="onScopeChannels">
          <text>自定义频道</text>
          <text wx:if="{{channelsCount}}" class="scope-badge" catchtap="onOpenChannels">{{channelsCount}}</text>
        </view>
      </view>
      <view wx:if="{{scope === 'channels'}}" class="manage-channels" hover-class="btn-hover" bindtap="onOpenChannels">
        <text class="manage-plus">＋</text>{{channelsCount ? '管理频道' : '添加频道'}}
      </view>
    <view wx:if="{{searched && !loading && !paused}}" class="search-actions">
      <view class="action-left">
        <button size="mini" wx:if="{{searched && !loading && !paused}}" class="reset-button" hover-class="reset-pressed" bindtap="onReset" aria-label="重置搜索，清空关键词和结果"><image class="reset-symbol" src="/assets/reset-orange.svg" mode="aspectFit" aria-hidden="true" /><text>重置</text></button>
      </view>
    </view>
    </view>

    <view class="search-card">
    <view class="search-input-row">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{homeSearchPlaceholder}}"
        placeholder-class="search-placeholder"
        confirm-type="search"
        maxlength="100"
        bindinput="onInput"
        bindconfirm="onSearchTap" />
      <button size="mini" wx:if="{{keyword}}" class="clear-btn" catchtap="onClearInput" hover-class="clear-pressed" aria-label="清空搜索关键词"><view class="clear-surface"><view class="clear-symbol" aria-hidden="true"></view></view></button>
    </view>
      <button wx:if="{{loading}}" size="mini" class="search-btn search-btn-pause" hover-class="btn-hover" bindtap="onPause">暂停</button>
      <button wx:elif="{{paused}}" size="mini" class="search-btn" hover-class="btn-hover" bindtap="onContinue">继续</button>
      <button wx:else size="mini" class="search-btn" hover-class="btn-hover" bindtap="onSearchTap">搜索</button>

    </view>
  </view>

  <view wx:if="{{!searched && searchHistory.length}}" class="search-history">
    <view class="history-heading"><text>最近搜过</text><button size="mini" class="history-clear" bindtap="onClearHistory">清空记录</button></view>
    <view class="history-list"><view wx:for="{{searchHistory}}" wx:key="*this" class="history-chip"><button size="mini" class="history-term" data-term="{{item}}" bindtap="onHotTap">{{item}}</button><button size="mini" class="history-remove" data-term="{{item}}" bindtap="onRemoveHistory" aria-label="删除搜索记录：{{item}}">×</button></view></view>
  </view>

  <view wx:if="{{!searched && showHotSearch && hotSearches.length}}" class="hot-section">
    <view class="hot-title"><text class="hot-star">✳</text> 此刻，大家在找</view>
    <view class="hot-grid">
      <view
        wx:for="{{hotSearches}}"
        wx:key="term"
        class="hot-item {{item.rank <= 3 ? 'top' : ''}}"
        hover-class="btn-hover"
        data-term="{{item.term}}"
        bindtap="onHotTap">
        <text class="hot-rank">{{item.rank}}</text>
        <text class="hot-term">{{item.term}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{searched}}">
    <view class="stats-bar card">
      <view class="stats-main">
        <view class="stat-item">
          <text class="stat-label">结果</text>
          <text class="stat-value">{{total}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">用时</text>
          <text class="stat-value">{{elapsedText}}</text>
        </view>
        <view wx:if="{{paused}}" class="paused-pill">搜索已暂停</view>
      </view>
      <scroll-view wx:if="{{pills.length > 1}}" class="pills-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="pills-track">
          <view
            wx:for="{{pills}}"
            wx:key="type"
            class="filter-pill {{item.active ? 'active' : ''}}"
            hover-class="none"
            data-type="{{item.type}}"
            bindtap="onPillTap">
            <text>{{item.label}}</text>
            <text class="pill-count">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{total > 0}}" class="sort-toolbar">
        <view class="sort-heading"><text wx:if="{{loading || paused}}" class="sort-hint">搜索完成后可排序</text></view>
        <view class="sort-options">
          <button size="mini" wx:for="{{sortOptions}}" wx:key="*this" class="sort-option {{sortIndex === index ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="onSortTap" disabled="{{loading || paused}}" hover-class="sort-pressed" aria-label="{{item}}{{sortIndex === index ? '，已选中' : ''}}">{{item}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="error-banner">
      <text class="error-icon">!</text>
      <text>{{error}}</text>
    </view>

    <view wx:if="{{results.length}}" class="resource-list card">
      <view wx:for="{{results}}" wx:key="id" class="resource-list-item">
        <resource-card
          theme="{{theme}}"
          item="{{item}}" />
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more card" hover-class="btn-hover" bindtap="onLoadMore">
      {{loading ? "正在加载…" : (loadMoreText || "显示更多结果")}}
    </view>

    <view wx:if="{{isEmpty}}" class="empty-card card">
      <view class="empty-icon">⌕</view>
      <view class="empty-title">未找到相关资源</view>
      <view class="empty-desc">试试其他关键词，或检查搜索范围设置</view>
    </view>
  </block>

  <button size="mini" wx:if="{{showBackTop}}" class="back-top" bindtap="onBackTop" aria-label="一键回到顶部">↑</button>
  <app-feedback top="{{navBarHeight}}" theme="{{theme}}" toast="{{feedbackToast}}" modal="{{feedbackModal}}" loading="{{busy}}" loading-text="正在处理…" bindconfirm="onFeedbackConfirm" bindcancel="onFeedbackCancel" />
</view>
