.channels {
  padding: 28rpx 24rpx 48rpx;
}

.add-card {
  padding: 28rpx;
}

.add-hint {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 20rpx;
  background: var(--bg-secondary);
  color: var(--text-primary);
  font-size: 28rpx;
}

.add-placeholder { color: var(--text-tertiary); }

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 152rpx;
  min-height: 80rpx;
  border-radius: 20rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.add-btn.disabled { opacity: 0.6; }

.add-error {
  margin-top: 16rpx;
  color: var(--error);
  font-size: 24rpx;
  line-height: 1.6;
}

.list-card {
  margin-top: 24rpx;
  overflow: hidden;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.list-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.list-count {
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.channel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 32rpx;
}

.channel-row + .channel-row {
  border-top: 1rpx solid var(--border-light);
}

.channel-name {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
  word-break: break-all;
}

.remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 112rpx;
  min-height: 60rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 14rpx;
  color: var(--error);
  font-size: 24rpx;
}

.list-empty {
  padding: 32rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx auto 0;
  min-height: 88rpx;
  padding: 0 64rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-card {
  margin-top: 80rpx;
  padding: 64rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 88rpx;
  opacity: 0.6;
}

.empty-title {
  margin-top: 20rpx;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.footnote {
  margin-top: 32rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
  text-align: center;
}

.btn-hover { opacity: 0.82; }
