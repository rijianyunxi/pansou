<view class="resource-item theme-{{theme}}">
  <view class="resource-heading">
    <view class="heading-main">
      <text class="resource-title" user-select>{{item.name}}</text>
      <view wx:if="{{item.description}}" class="resource-desc {{descExpanded ? 'is-expanded' : ''}}">
        <text class="desc-content">{{item.description}}</text>
        <text wx:if="{{item.hasLongDesc || descExpanded}}" class="desc-toggle" catchtap="toggleDesc">{{descExpanded ? '收起' : '展开'}}</text>
      </view>
    </view>
    <text wx:if="{{item.dateText}}" class="resource-date">{{item.dateText}}</text>
  </view>

  <view class="resource-links">
    <view wx:for="{{item.links}}" wx:for-item="link" wx:key="key" class="link-row">
      <view class="link-icon">{{link.icon}}</view>
      <view class="link-main">
        <text class="link-provider {{link.type}}">{{link.label}}</text>
        <button wx:if="{{resolved[link.key].password}}" class="password-badge" size="mini" disabled="{{!!loading[link.key] || copyingPassword}}" data-key="{{link.key}}" bindtap="onCopyPassword" aria-label="复制提取码">提取码 {{resolved[link.key].password}} · 复制</button>
      </view>
      <view class="link-actions">
        <button size="mini" class="link-btn" hover-class="btn-hover" disabled="{{!!loading[link.key]}}" loading="{{loading[link.key] === 'open'}}" data-key="{{link.key}}" bindtap="onOpen">{{loading[link.key] === 'open' ? '正在获取' : '打开资源'}}</button>
        <button size="mini" class="link-btn" hover-class="btn-hover" disabled="{{!!loading[link.key]}}" loading="{{loading[link.key] === 'copy'}}" data-key="{{link.key}}" bindtap="onCopy">{{loading[link.key] === 'copy' ? '正在复制' : copiedKey === link.key ? '已复制' : '复制链接'}}</button>
      </view>

    </view>
  </view>
</view>

<view wx:if="{{dialog}}" class="link-dialog-mask" catchtouchmove="noop" bindtap="closeDialog">
  <view class="link-dialog" catchtap="noop" aria-role="dialog" aria-modal="true" aria-label="获取资源链接">
    <button class="dialog-close" aria-label="关闭取链窗口" bindtap="closeDialog">×</button>
    <view class="dialog-symbol {{dialog.status}}" aria-hidden="true">
      <view wx:if="{{dialog.status === 'loading'}}" class="dialog-orbit"></view>
      <view wx:if="{{dialog.status === 'loading'}}" class="dialog-chain"><view></view><view></view></view>
      <text wx:elif="{{dialog.status === 'error'}}" class="dialog-exclamation">!</text>
      <view wx:else class="dialog-check"></view>
    </view>
    <text class="dialog-title">{{dialog.status === 'loading' ? '正在获取链接' : dialog.status === 'success' ? '链接已复制' : dialog.status === 'ready' ? '链接已就绪' : '暂时没能完成'}}</text>
    <text class="dialog-description" aria-role="status">{{dialog.message || (dialog.slow ? '这次需要多等一会儿，你也可以稍后继续。' : dialog.action === 'copy' ? '准备好后会自动复制到剪贴板。' : '准备好后，点击打开即可查看资源。')}}</text>
    <view class="dialog-resource"><text class="dialog-provider">{{dialog.provider}}</text><text class="dialog-name">{{dialog.name}}</text></view>
    <view wx:if="{{dialog.status === 'loading'}}" class="dialog-wait"><view class="wait-dots"><view></view><view></view><view></view></view><text>{{dialog.slow ? '正在耐心等待响应' : '稍等片刻就好'}}</text></view>
    <view class="dialog-actions">
      <button wx:if="{{dialog.status === 'loading'}}" class="dialog-secondary" bindtap="closeDialog">稍后继续</button>
      <block wx:elif="{{dialog.status === 'error'}}"><button class="dialog-secondary" bindtap="closeDialog">关闭</button><button wx:if="{{dialog.retryable !== false}}" class="dialog-primary" bindtap="retryDialog">再试一次</button></block>
      <block wx:elif="{{dialog.status === 'ready'}}"><button class="dialog-secondary" bindtap="copyReady">复制链接</button><button class="dialog-primary" bindtap="openReady">打开资源</button></block>
      <button wx:else class="dialog-primary" bindtap="closeDialog">完成</button>
    </view>
  </view>
</view>
