/* Ported from components/ResultGroup.vue mobile layout (≤560px). */
.theme-geometric {
  --bg-primary: #fffefa; --bg-secondary: #fffbed; --primary: #3155e7;
  --primary-soft: #e1e4fc; --text-primary: #20201e; --text-secondary: #56564f;
  --text-tertiary: #69695f; --border-light: #20201e; --radius-md: 10rpx;
}
.resource-item {
  padding: 30rpx 26rpx;
  background: var(--bg-primary);
}

.resource-heading {
  display: block;
}

.heading-main { min-width: 0; }

.resource-title {
  display: block;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.resource-desc { margin-top: 10rpx; }

.desc-content {
  display: -webkit-box;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  /* max-height backs up the line clamp: it also works on renderers that
     ignore -webkit-box, so the collapse state never silently fails. */
  max-height: 88rpx;
}

.resource-desc.is-expanded .desc-content {
  display: block;
  max-height: none;
}

.desc-toggle {
  display: inline-block;
  margin-top: 6rpx;
  padding: 8rpx 0;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.resource-date {
  display: block;
  margin-top: 12rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  padding: 12rpx 0;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 12rpx;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 36rpx;
}

.resource-links {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* Provider above two stable actions: no squeezed labels on narrow screens. */
.link-row {
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  background: var(--bg-secondary);
}

.link-icon {
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--bg-primary);
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1;
}

.link-main {
  flex: 1 1 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  min-height: 60rpx;
  min-width: 0;
  overflow: hidden;
}

.link-provider {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.password-badge {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: var(--text-tertiary);
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.link-actions {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
}

.link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  min-width: 0;
  width: 100%;
  margin: 0;
  max-width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 16rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  white-space: normal;
}
.link-main text { overflow-wrap: anywhere; }
.link-btn[disabled] { opacity: .55; }
.link-btn::after { border: none; }

.btn-hover {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}
