
.resource-item {
  padding: 30rpx 26rpx;
  background: var(--bg-primary);
}

.resource-heading {
  display: block;
}

.heading-main { min-width: 0; }

.resource-title {
  display: block;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.resource-desc { margin-top: 10rpx; }

.desc-content {
  display: -webkit-box;
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  /* max-height backs up the line clamp: it also works on renderers that
     ignore -webkit-box, so the collapse state never silently fails. */
  max-height: 88rpx;
}

.resource-desc.is-expanded .desc-content {
  display: block;
  max-height: none;
}

.desc-toggle {
  display: inline-block;
  margin-top: 6rpx;
  padding: 8rpx 0;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.resource-date {
  display: block;
  margin-top: 12rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  padding: 12rpx 0;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 12rpx;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 36rpx;
}

.resource-links {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* Provider above the copy action. */
.link-row {
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 24rpx;
  background: var(--bg-secondary);
}

.link-icon {
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--bg-primary);
  color: var(--primary);
  font-size: 28rpx;
  line-height: 1;
}

.link-main {
  flex: 1 1 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  min-height: 60rpx;
  min-width: 0;
  overflow: hidden;
}

.link-provider {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.password-badge {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  color: var(--text-tertiary);
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.link-actions {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
}

.link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  min-width: 0;
  width: 100%;
  margin: 0;
  max-width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 16rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  white-space: normal;
}
.link-main text { overflow-wrap: anywhere; }
.link-btn[disabled] { opacity: .55; }
.link-btn::after { border: none; }
.link-progress { grid-column: 1 / -1; min-width: 0; }
.progress-caption { display: flex; align-items: center; gap: 14rpx; color: var(--text-secondary); font-size: 24rpx; }
.progress-elapsed { margin-left: auto; color: var(--text-tertiary); }
.progress-spinner { width: 24rpx; height: 24rpx; border: 3rpx solid var(--border-light); border-top-color: var(--text-primary); border-radius: 50%; animation: link-spin .8s linear infinite; }
.progress-track { height: 6rpx; margin-top: 18rpx; border-radius: 999rpx; overflow: hidden; background: var(--border-light); }
.progress-sweep { width: 35%; height: 100%; border-radius: inherit; background: var(--text-secondary); animation: link-sweep 1.6s ease-in-out infinite; }
@keyframes link-spin { to { transform: rotate(360deg); } }
@keyframes link-sweep { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
@media (prefers-reduced-motion: reduce) { .progress-spinner, .progress-sweep { animation: none; } }

.btn-hover {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}
.resource-item { --primary: #e85116; --bg-primary: #fff; --bg-secondary: #fff8ef; --text-primary: #24231f; --text-secondary: #706c65; --text-tertiary: #827c73; --border-light: #ece7de; padding: 26rpx; }
.resource-title { font-size: 30rpx; }
.link-row { border: 0; padding: 0; background: transparent; }
.link-icon { display: none; }
.link-provider { color: #c74510; background: #fff0e6; padding: 4rpx 12rpx; border-radius: 22rpx; font-size: 22rpx; }
.link-btn { border-radius: 14rpx; min-height: 88rpx; font-size: 24rpx; }
.link-btn:first-child { border-color: #f65b1b; color: #d84912; }
.resource-date { font-size: 22rpx; }
.link-row { grid-template-columns: minmax(0, 1fr); }
.link-provider.quark { color: #6340d7; background: #f0eaff; }
.link-provider.baidu { color: #216acf; background: #eaf2ff; }
.link-provider.aliyun { color: #b86112; background: #fff0dc; }

/* Explicit sizing overrides WeChat's native default button width and margins. */
.resource-item .link-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.resource-item .link-main { flex: 1 1 180rpx; min-width: 0; }
.resource-item .link-actions { display: flex; flex: 0 0 auto; margin-left: auto; }
.resource-item button.link-btn { display: flex; flex: none; align-items: center; justify-content: center; width: auto; min-width: 160rpx; max-width: 100%; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 22rpx; font-family: inherit; font-size: 24rpx; font-weight: 500; line-height: 32rpx; white-space: nowrap; border: 1rpx solid #f5be9b; border-radius: 12rpx; background: #fff8f2; color: #d84912; box-sizing: border-box; }
.resource-item .link-progress { flex: 1 0 100%; }
.resource-item button.password-badge { display: inline-block; width: auto; min-height: 48rpx; margin: 0; padding: 4rpx 10rpx; font-size: 22rpx; line-height: 36rpx; color: inherit; background: transparent; border: 1rpx solid currentColor; border-radius: 8rpx; white-space: normal; }
.resource-item button.password-badge::after { border: 0; }

.link-dialog-mask { position: fixed; inset: 0; z-index: 2100; display: flex; align-items: center; justify-content: center; padding: 40rpx; box-sizing: border-box; background: rgba(35,27,20,.42); }
.link-dialog { position: relative; width: 100%; max-width: 690rpx; max-height: 90vh; overflow-y: auto; padding: 64rpx 48rpx 44rpx; box-sizing: border-box; border: 1rpx solid #ece7de; border-radius: 44rpx; background: #fffdf9; color: #24231f; text-align: center; animation: dialog-in .2s ease-out; }
.dialog-close { position: absolute; right: 12rpx; top: 12rpx; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; color: #706c65; background: transparent; font-size: 44rpx; line-height: 88rpx; }.dialog-close::after,.dialog-actions button::after { border: 0; }
.dialog-symbol { position: relative; display: flex; align-items: center; justify-content: center; width: 140rpx; height: 140rpx; margin: 6rpx auto 40rpx; border-radius: 50%; background: #fff0e5; color: #da541c; }
.dialog-symbol.error { background: #fff0ed; color: #bc442d; }
.dialog-orbit { position: absolute; inset: -4rpx; border: 4rpx solid transparent; border-top-color: #da541c; border-right-color: #f8d5c4; border-radius: 50%; animation: dialog-spin 1.1s linear infinite; }
.dialog-chain { position: relative; width: 62rpx; height: 62rpx; transform: rotate(-40deg); }.dialog-chain view { position: absolute; left: 5rpx; top: 17rpx; width: 32rpx; height: 23rpx; border: 4rpx solid #da541c; border-radius: 14rpx; }.dialog-chain view + view { left: 28rpx; }
.dialog-check { width: 45rpx; height: 23rpx; border-left: 5rpx solid #da541c; border-bottom: 5rpx solid #da541c; transform: translateY(-6rpx) rotate(-45deg); }.dialog-exclamation { font-size: 64rpx; line-height: 1; font-weight: 500; }
.dialog-title { display: block; font-size: 40rpx; line-height: 1.4; font-weight: 650; }.dialog-description { display: block; margin: 20rpx 0 40rpx; min-height: 80rpx; color: #706c65; font-size: 27rpx; line-height: 1.65; }
.dialog-resource { padding: 24rpx 28rpx; border-radius: 22rpx; background: #fff4e9; text-align: left; }.dialog-provider { display: block; color: #bd491b; font-size: 24rpx; font-weight: 600; }.dialog-name { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 8rpx; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.dialog-wait { display: flex; align-items: center; justify-content: center; gap: 18rpx; min-height: 84rpx; color: #706c65; font-size: 24rpx; }.wait-dots { display: flex; gap: 8rpx; }.wait-dots view { width: 8rpx; height: 8rpx; background: #da541c; border-radius: 50%; animation: dialog-pulse 1.2s ease-in-out infinite; }.wait-dots view:nth-child(2){animation-delay:.15s}.wait-dots view:nth-child(3){animation-delay:.3s}
.dialog-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }.dialog-wait + .dialog-actions { margin-top: 0; }.dialog-actions button { flex: 1; margin: 0; min-height: 92rpx; padding: 22rpx 16rpx; border: 1rpx solid #e7dfd4; border-radius: 20rpx; box-sizing: border-box; font-size: 28rpx; font-weight: 600; line-height: 1.5; }.dialog-primary { color: #fff; background: #c84916; }.dialog-secondary { color: #706c65; background: #fffdf9; }
@keyframes dialog-in { from { opacity: 0; transform: translateY(12rpx) scale(.98); } to { opacity: 1; transform: none; } }@keyframes dialog-spin { to { transform: rotate(360deg); } }@keyframes dialog-pulse { 50% { opacity: .3; } }
@media(prefers-reduced-motion:reduce) { .link-dialog,.dialog-orbit,.wait-dots view { animation: none; } }

/* Keep both link actions comfortably tappable on narrow screens. */
.resource-item .link-actions { flex-wrap: wrap; gap: 16rpx; }
.resource-item button.link-btn { min-height: 88rpx; height: auto; }
