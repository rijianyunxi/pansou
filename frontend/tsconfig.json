{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "~/*": ["./*"], "@/*": ["./*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "app.vue", "pages/**/*.vue", "components/**/*.vue", "composables/**/*.ts", "utils/**/*.ts", "shared/**/*.ts", "types/**/*.ts"]
}
