{
  "schemaVersion": 1,
  "manifest": {
    "id": "example-json-basic",
    "name": "Example JSON Search",
    "version": "1.0.0",
    "kind": "instructions",
    "priority": 50,
    "timeoutMs": 10000,
    "maxResults": 50,
    "schemaVersion": 1,
    "outputTypes": ["quark", "baidu"]
  },
  "request": {
    "method": "GET",
    "url": "https://search.example.com/api/resources",
    "query": {
      "q": "{{keyword}}",
      "page": "{{page}}",
      "size": "{{limit}}"
    },
    "headers": {
      "user-agent": "PanHub/1.0 (+https://example.com)"
    },
    "timeoutMs": 8000,
    "maxResponseBytes": 2097152,
    "redirect": "follow"
  },
  "response": {
    "format": "json",
    "items": "data.list",
    "fields": {
      "title": "name",
      "content": {
        "path": "detail",
        "regex": { "pattern": "提取码[:：]\\s*(\\w{4})" }
      },
      "datetime": "updated_at",
      "uniqueId": "id"
    },
    "links": {
      "array": "links",
      "url": "url",
      "type": "type",
      "password": "pwd"
    },
    "nextPage": { "queryParam": "page", "maxPages": 3 }
  }
}
