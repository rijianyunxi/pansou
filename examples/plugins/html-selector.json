{
  "schemaVersion": 1,
  "manifest": {
    "id": "example-html-selector",
    "name": "Example HTML Selector Search",
    "version": "1.0.0",
    "kind": "instructions",
    "priority": 40,
    "timeoutMs": 10000,
    "maxResults": 50,
    "schemaVersion": 1
  },
  "request": {
    "method": "GET",
    "url": "https://www.example.com/search",
    "query": {
      "q": "{{keyword}}"
    },
    "timeoutMs": 8000,
    "maxResponseBytes": 2097152
  },
  "response": {
    "format": "html",
    "items": "ul.results > li.item",
    "fields": {
      "title": { "selector": "h3.title", "source": "text" },
      "content": { "selector": "p.desc", "source": "text", "default": "" },
      "datetime": { "selector": "time", "source": "attr", "attribute": "datetime" },
      "messageId": { "selector": "", "source": "attr", "attribute": "data-id" }
    },
    "links": {
      "selector": "a.share",
      "url": { "selector": "", "source": "href" },
      "type": { "source": "constant", "value": "quark" },
      "password": {
        "selector": ".pwd",
        "source": "text",
        "regex": { "pattern": "密码：(\\w{4})" }
      }
    },
    "nextPage": { "selector": "a.next-page", "maxPages": 5 }
  }
}
