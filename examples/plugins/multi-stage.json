{
  "schemaVersion": 1,
  "manifest": {
    "id": "example-multi-stage",
    "name": "Example Multi-stage Search",
    "version": "1.0.0",
    "kind": "instructions",
    "priority": 60,
    "timeoutMs": 15000,
    "maxResults": 30,
    "schemaVersion": 1,
    "upstreamGroup": "example-group",
    "upstreamWeight": 10
  },
  "request": {
    "method": "POST",
    "url": "https://api.example.com/v1/search",
    "allowedDomains": ["example.com"],
    "query": {
      "build": "{{buildId}}",
      "sign": "{{sign}}"
    },
    "headers": {
      "x-client-token": "{{token}}",
      "x-app-key": "{{secret.appKey}}"
    },
    "bodyType": "json",
    "body": {
      "keyword": "{{keyword}}",
      "buildId": "{{buildId}}",
      "size": "{{limit}}"
    },
    "timeoutMs": 12000,
    "maxResponseBytes": 2097152,
    "secrets": ["appKey"],
    "stages": [
      {
        "method": "GET",
        "url": "https://api.example.com/v1/token",
        "timeoutMs": 5000,
        "response": {
          "format": "json",
          "vars": {
            "token": "data.token",
            "buildId": "data.buildId"
          }
        }
      },
      {
        "method": "GET",
        "url": "https://api.example.com/status",
        "timeoutMs": 5000,
        "response": {
          "format": "html",
          "vars": {
            "sign": { "selector": "#sign", "source": "attr", "attribute": "data-sign" }
          }
        }
      }
    ]
  },
  "response": {
    "format": "json",
    "items": "data.items",
    "fields": {
      "title": "title",
      "content": "note"
    },
    "links": {
      "array": "drives",
      "url": "link",
      "type": "pan",
      "password": "pass"
    }
  }
}
