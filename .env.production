PANHUB_SQLITE_DB=./data/panhub.sqlite
LOG_LEVEL=info
NITRO_HOST=127.0.0.1
NITRO_PORT=3666

# 从转发头解析真实客户端 IP（server/utils/clientIp.ts）。开启前提：
# 1) 应用只监听 127.0.0.1，公网无法直连（上面的 NITRO_HOST 已满足）；
# 2) 反向代理会写入 X-Forwarded-For，并剥掉客户端自带的 CF-Connecting-IP。
# 若代理只是把客户端自带的头原样追加/透传，按 IP 的限流可被伪造头绕过。
NUXT_TRUST_PROXY=true
PANHUB_ADMIN_INITIAL_PASSWORD=