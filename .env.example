# 上游/SSE 调试日志：debug 时服务端控制台打印请求、错误和完整 SSE 事件。
PANHUB_SQLITE_DB=./data/panhub.sqlite

LOG_LEVEL=info

NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# 仅当 Nuxt 只接受来自可信反向代理的请求时启用；否则不要信任
# X-Forwarded-For / CF-Connecting-IP。
NUXT_TRUST_PROXY=false

# 前端请求后端 API 的基础路径；默认通过当前站点的 /api 反向代理到 Nuxt 服务，通常无需修改。
NUXT_PUBLIC_API_BASE=/api

# 站点品牌和 SEO 配置；生产环境请在 .env.production 中填写实际值。
NUXT_PUBLIC_SITE_NAME=PanHub
NUXT_PUBLIC_HOME_TITLE=网盘资源聚合搜索
NUXT_PUBLIC_HOME_DESCRIPTION=网盘、磁力、公开频道，一个搜索框直达。
NUXT_PUBLIC_SITE_TITLE=网盘资源聚合搜索 · PanHub
NUXT_PUBLIC_SITE_DESCRIPTION=PanHub 聚合网盘、磁力链接与公开频道资源，支持百度网盘、夸克、阿里云盘、115、迅雷等平台。一个搜索框，查找分享链接，按平台筛选结果。
NUXT_PUBLIC_SITE_KEYWORDS=PanHub, 网盘搜索, 网盘资源搜索, 聚合搜索, 百度网盘, 夸克网盘, 阿里云盘, 115网盘, 迅雷云盘, 磁力链接, 公开频道搜索
NUXT_PUBLIC_SITE_IMAGE_ALT=PanHub 网盘资源聚合搜索：网盘、磁力、公开频道，一个搜索框直达。
# 站点对外访问地址，用于公共链接、SEO 和分享信息。
NUXT_PUBLIC_SITE_URL=https://你的域名
