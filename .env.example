# ============================================================================
# pansou 默认配置模板
#
# 本文件不包含真实密钥，可以复制为 .env 后直接用于本地或首次部署：
#   cp .env.example .env
#
# 运行前需要 PostgreSQL 和 Redis：docker compose up -d postgres redis
# 生产环境请修改数据库密码、管理员密码，并按实际反向代理配置调整监听项。
# ============================================================================

# 必填：PostgreSQL / Redis 连接。
# docker-compose 已把端口绑定在 127.0.0.1，默认账号密码见 docker-compose.yml。
PANSOU_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pansou
PANSOU_REDIS_URL=redis://127.0.0.1:6379/

# 首次启动创建管理员账号用；留空则随机生成（只打印在启动日志里）。
PANSOU_ADMIN_INITIAL_PASSWORD=

# 挂在 Nginx/Caddy 等可信反向代理后，只监听本机并开启可信代理头：PANSOU_TRUST_PROXY_HEADERS=true
PANSOU_API_HOST=127.0.0.1
PANSOU_API_PORT=3666
PANSOU_TRUST_PROXY_HEADERS=true

# 是否在 API 进程内启动采集和链接解析 Worker；单独部署 Worker 时改为 false。
PANSOU_EMBEDDED_WORKERS=true

# 网盘凭证加密：首次保存时生成 0600 权限的 32 字节密钥文件。
# API 与 link-worker 必须共享同一密钥；数据库备份需要同时备份该文件。
# 容器、只读部署或多机部署请通过密钥管理器提供 Base64 编码的 32 字节密钥。
# 不要更换已有密钥，不要提交到 Git。认证维护不受 EMBEDDED_WORKERS 开关影响。
PANSOU_CLOUD_KEY_FILE=data/cloud-credentials.key
# PANSOU_CLOUD_CREDENTIAL_KEY=

# 日志过滤规则。
RUST_LOG=pansou_api=info,tower_http=info

# PostgreSQL 连接池：默认值适合 2 核 / 2 GB 左右的单机起步部署。
PANSOU_DB_MAX_CONNECTIONS=32
PANSOU_DB_MIN_CONNECTIONS=2
PANSOU_DB_ACQUIRE_TIMEOUT_SECONDS=10
PANSOU_DB_IDLE_TIMEOUT_SECONDS=600
PANSOU_DB_MAX_LIFETIME_SECONDS=1800

# Redis 超时配置（单位：秒）。
PANSOU_REDIS_CONNECTION_TIMEOUT_SECONDS=3
PANSOU_REDIS_RESPONSE_TIMEOUT_SECONDS=5

# 搜索网段额度相对于单 IP 额度的倍数。
PANSOU_SEARCH_SUBNET_LIMIT_MULTIPLIER=4
