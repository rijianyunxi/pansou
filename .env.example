PANHUB_SQLITE_DB=./data/panhub.sqlite
LOG_LEVEL=info
NITRO_HOST=127.0.0.1
NITRO_PORT=3666

# 从转发头解析真实客户端 IP（server/utils/clientIp.ts）。保留 false 时所有按 IP 的
# 限流会退化为全站共用配额，审计日志中的 IP 也不可溯源。开启前提：应用不可公网直连，
# 且反向代理会写入 X-Forwarded-For 并剥掉客户端自带的 CF-Connecting-IP。
# 生产环境已开启（见 .env.production）；详见 README「生产环境」一节。
# NUXT_TRUST_PROXY=true

# 初始管理员口令。仅在数据库里还没有任何管理员时生效：留空则随机生成，
# 并在启动日志里打印一次（仓库不提供默认口令，管理员也没有口令找回通道）。
# PANHUB_ADMIN_INITIAL_PASSWORD=
