# 复制为 .env 后填入真实 Cookie（.env 已在 .gitignore 中忽略）
#
# 夸克网盘：浏览器登录 pan.quark.cn 后，F12 → Network → 任意请求 → 复制完整 Cookie
QUARK_COOKIE=

# 百度网盘：浏览器登录 pan.baidu.com/disk/main 后，F12 → Network → 找 main 请求 → 复制完整 Cookie
# 必须包含 BDUSS（或 BDUSS_BFESS）、BAIDUID、STOKEN
BAIDU_COOKIE=

# 可选：接口域名覆盖（默认见各 provider，一般无需修改）
# QUARK_SHARE_BASE=https://drive.quark.cn/1/clouddrive
# QUARK_PC_BASE=https://drive-pc.quark.cn/1/clouddrive
# BAIDU_BASE=https://pan.baidu.com

# 可选：请求超时（毫秒），默认 30000
# WANGPAN_TIMEOUT_MS=30000
